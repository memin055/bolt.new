'use client';
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { useState } from "react";

const versions = [
  {
    version: "3.9.0-174",
    date: "2025-07-30",
    features: ["New quoting feature", "Logo update"],
    bugFixes: ["Android crash fixed", "Scroll bug resolved"]
  }
];

export default function NexlyApp() {
  const [selectedVersion, setSelectedVersion] = useState(null);
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [loggedIn, setLoggedIn] = useState(false);

  const handleLogin = () => {
    if (email && password) {
      setLoggedIn(true);
    } else {
      alert("Please enter email and password.");
    }
  };

  if (!loggedIn) {
    return (
      <div className="min-h-screen flex items-center justify-center p-4 bg-gray-100">
        <div className="max-w-md w-full bg-white rounded-2xl shadow-xl p-8 space-y-4">
          <h1 className="text-3xl font-bold text-center">NEXLY</h1>
          <p className="text-center text-gray-500">Login or join the community</p>
          <Input type="email" placeholder="Email" value={email} onChange={(e) => setEmail(e.target.value)} />
          <Input type="password" placeholder="Password" value={password} onChange={(e) => setPassword(e.target.value)} />
          <Button className="w-full" onClick={handleLogin}>Login</Button>
        </div>
      </div>
    );
  }

  return (
    <div className="p-4 max-w-3xl mx-auto">
      <h1 className="text-2xl font-bold mb-4 text-center">Release Notes</h1>
      <div className="grid gap-4">
        {versions.map((ver, idx) => (
          <Card key={idx} onClick={() => setSelectedVersion(ver)} className="cursor-pointer hover:shadow-lg">
            <CardContent className="p-4">
              <h2 className="text-lg font-semibold">Version: {ver.version}</h2>
              <p className="text-sm text-gray-500">Date: {ver.date}</p>
            </CardContent>
          </Card>
        ))}
      </div>

      {selectedVersion && (
        <div className="mt-6">
          <h2 className="text-xl font-bold mb-2">Details ({selectedVersion.version})</h2>
          <h3 className="text-lg font-semibold mt-4">✨ Features</h3>
          <ul className="list-disc ml-5 text-sm text-green-700">
            {selectedVersion.features.map((f, i) => (
              <li key={i}>{f}</li>
            ))}
          </ul>

          <h3 className="text-lg font-semibold mt-4">🐞 Bug Fixes</h3>
          <ul className="list-disc ml-5 text-sm text-red-700">
            {selectedVersion.bugFixes.map((b, i) => (
              <li key={i}>{b}</li>
            ))}
          </ul>

          <Button className="mt-4" onClick={() => setSelectedVersion(null)}>Back</Button>
        </div>
      )}
    </div>
  );
}
